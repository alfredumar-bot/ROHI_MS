<ServerConnectionScreen>:
    MDScreen:
        md_bg_color: 0.95, 0.95, 0.95, 1

        MDBoxLayout:
            orientation: 'vertical'

            MDTopAppBar:
                title: "Server Connection"
                elevation: 2
                md_bg_color: 0.13, 0.40, 0.16, 1
                left_action_items: [["arrow-left", lambda x: app.open_settings()]]

            ScrollView:
                do_scroll_x: False

                MDBoxLayout:
                    orientation: 'vertical'
                    padding: dp(16)
                    spacing: dp(16)
                    size_hint_y: None
                    height: self.minimum_height

                    # ---------------- Status Card ----------------
                    MDCard:
                        orientation: 'vertical'
                        padding: dp(16)
                        spacing: dp(6)
                        size_hint_y: None
                        height: self.minimum_height
                        radius: [12,]
                        elevation: 2

                        MDBoxLayout:
                            orientation: 'horizontal'
                            spacing: dp(10)
                            adaptive_height: True

                            MDLabel:
                                text: "Connection Status:"
                                bold: True
                                adaptive_size: True
                                valign: "middle"

                            Widget:
                                size_hint_x: None
                                width: dp(1)

                            MDCard:
                                id: connection_status_badge
                                orientation: 'horizontal'
                                size_hint: None, None
                                size: self.minimum_width, dp(30)
                                padding: [dp(10), dp(4)]
                                spacing: dp(6)
                                radius: [15,]
                                elevation: 0
                                md_bg_color: 0.93, 0.85, 0.85, 1

                                MDIcon:
                                    id: connection_status_icon
                                    icon: "close-circle"
                                    theme_text_color: "Custom"
                                    text_color: 0.6, 0.15, 0.15, 1
                                    size_hint: None, None
                                    size: dp(18), dp(18)
                                    pos_hint: {"center_y": .5}

                                MDLabel:
                                    id: connection_status_label
                                    text: "Not Connected"
                                    bold: True
                                    theme_text_color: "Custom"
                                    text_color: 0.6, 0.15, 0.15, 1
                                    adaptive_size: True
                                    valign: "middle"
                                    pos_hint: {"center_y": .5}

                        MDLabel:
                            id: last_sync_label
                            text: "Last Sync: Never"
                            font_style: "Caption"
                            theme_text_color: "Secondary"
                            adaptive_height: True

                        MDLabel:
                            id: sync_result_label
                            text: ""
                            font_style: "Caption"
                            theme_text_color: "Secondary"
                            adaptive_height: True

                    # ---------------- Connection Fields ----------------
                    MDCard:
                        orientation: 'vertical'
                        padding: dp(16)
                        spacing: dp(12)
                        size_hint_y: None
                        height: self.minimum_height
                        radius: [12,]
                        elevation: 2

                        MDTextField:
                            id: server_name_field
                            hint_text: "Server Name"

                        MDTextField:
                            id: host_field
                            hint_text: "Host / IP"

                        MDTextField:
                            id: port_field
                            hint_text: "Port"
                            input_filter: "int"
                            text: "5432"

                        MDTextField:
                            id: dbname_field
                            hint_text: "Database Name"

                        MDTextField:
                            id: username_field
                            hint_text: "Username"

                        MDTextField:
                            id: password_field
                            hint_text: "Password"
                            password: True

                        MDTextField:
                            id: sslmode_field
                            hint_text: "SSL Mode (disable / allow / prefer / require)"
                            text: "prefer"

                    # ---------------- Google Form Link ----------------
                    MDCard:
                        orientation: 'vertical'
                        padding: dp(16)
                        spacing: dp(12)
                        size_hint_y: None
                        height: self.minimum_height
                        radius: [12,]
                        elevation: 2

                        MDLabel:
                            text: "Google Form"
                            font_style: "Subtitle1"
                            bold: True
                            adaptive_height: True

                        MDTextField:
                            id: google_form_url_field
                            hint_text: "Paste Google Form link here"

                        MDRaisedButton:
                            text: "OPEN GOOGLE FORM"
                            size_hint_x: 1
                            md_bg_color: 0.25, 0.45, 0.75, 1
                            on_release: app.open_google_form()

                        MDSeparator:

                        MDLabel:
                            text: "Automatic submission (fills the Sheet with no tap needed)"
                            font_style: "Caption"
                            bold: True
                            adaptive_height: True

                        MDTextField:
                            id: google_form_prefilled_url_field
                            hint_text: "Paste the Google Form PRE-FILLED link here"
                            multiline: True

                        MDRaisedButton:
                            text: "DETECT & SAVE FIELDS"
                            size_hint_x: 1
                            md_bg_color: 0.13, 0.40, 0.16, 1
                            on_release: app.save_google_form_prefilled_url()

                        MDLabel:
                            id: google_form_auto_sync_status_label
                            text: ""
                            font_style: "Caption"
                            theme_text_color: "Secondary"
                            adaptive_height: True

                    # ---------------- Actions ----------------
                    MDBoxLayout:
                        orientation: 'vertical'
                        spacing: dp(10)
                        size_hint_y: None
                        height: self.minimum_height

                        MDRaisedButton:
                            id: test_connection_btn
                            text: "TEST CONNECTION"
                            size_hint_x: 1
                            md_bg_color: 0.25, 0.45, 0.75, 1
                            on_release: app.server_connection_test()

                        MDRaisedButton:
                            id: save_settings_btn
                            text: "SAVE SETTINGS"
                            size_hint_x: 1
                            md_bg_color: 0.4, 0.4, 0.4, 1
                            on_release: app.server_connection_save()

                        MDRaisedButton:
                            id: connect_btn
                            text: "CONNECT"
                            size_hint_x: 1
                            md_bg_color: 0.13, 0.40, 0.16, 1
                            on_release: app.server_connection_connect()

                        MDRaisedButton:
                            id: disconnect_btn
                            text: "DISCONNECT"
                            size_hint_x: 1
                            md_bg_color: 0.8, 0.1, 0.1, 1
                            on_release: app.server_connection_disconnect()

                        MDRaisedButton:
                            id: sync_now_btn
                            text: "SYNCHRONIZE NOW"
                            size_hint_x: 1
                            md_bg_color: 0.85, 0.65, 0.13, 1
                            on_release: app.server_connection_sync_now()
