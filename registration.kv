<RegistrationScreen>:
    MDScreen:
        md_bg_color: 0.95, 0.95, 0.95, 1

        MDBoxLayout:
            orientation: 'vertical'

            MDTopAppBar:
                title: "ROHI Staff Registration"
                elevation: 2
                left_action_items: [["arrow-left", lambda x: app.open_dashboard() if app.current_user else app.open_login()]]

            ScrollView:
                do_scroll_x: False
                do_scroll_y: True

                MDBoxLayout:
                    orientation: 'vertical'
                    padding: dp(16)
                    spacing: dp(16)
                    size_hint_y: None
                    height: self.minimum_height

                    # ---------------- Header ----------------
                    MDBoxLayout:
                        orientation: 'vertical'
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: dp(2)
                        padding: [0, dp(4)]

                        MDLabel:
                            text: "ROHI"
                            font_style: "H4"
                            bold: True
                            halign: "center"
                            theme_text_color: "Custom"
                            text_color: 0.0, 0.55, 0.15, 1
                            adaptive_height: True

                        MDLabel:
                            text: "Welcome to Restoration of Hope Initiative (ROHI)\nSTAFF REGISTRATION"
                            font_style: "Subtitle1"
                            bold: True
                            halign: "center"
                            theme_text_color: "Custom"
                            text_color: 0.0, 0.55, 0.15, 1
                            adaptive_height: True

                        MDLabel:
                            text: "**Note: This app is strictly for ROHI staff only**"
                            font_style: "Caption"
                            bold: True
                            halign: "center"
                            adaptive_height: True

                        MDLabel:
                            text: "Fields marked with * are compulsory"
                            font_style: "Caption"
                            halign: "center"
                            theme_text_color: "Secondary"
                            adaptive_height: True

                    # ---------------- Personal Information ----------------
                    MDCard:
                        orientation: 'vertical'
                        padding: dp(16)
                        spacing: dp(12)
                        size_hint_y: None
                        height: self.minimum_height
                        radius: [12,]
                        elevation: 2

                        MDLabel:
                            text: "PERSONAL INFORMATION"
                            font_style: "Subtitle1"
                            bold: True
                            adaptive_height: True

                        MDSeparator:

                        # Name + Sex (left column) / Capture Photo (right box)
                        MDBoxLayout:
                            orientation: 'horizontal'
                            spacing: dp(12)
                            size_hint_y: None
                            height: dp(150)

                            MDBoxLayout:
                                orientation: 'vertical'
                                spacing: dp(12)
                                size_hint_x: 0.62

                                MDTextField:
                                    id: fullname
                                    hint_text: "Name *"
                                    mode: "rectangle"
                                    icon_left: "account"

                                MDTextField:
                                    id: sex
                                    hint_text: "Sex *"
                                    mode: "rectangle"
                                    icon_left: "account"
                                    icon_right: "gender-male-female"
                                    readonly: True
                                    on_touch_down: if self.collide_point(*args[1].pos): app.open_sex_menu()

                            MDCard:
                                orientation: 'vertical'
                                size_hint_x: 0.38
                                radius: [10,]
                                elevation: 1
                                md_bg_color: 0.92, 0.93, 0.95, 1
                                padding: dp(6)
                                spacing: dp(4)

                                FitImage:
                                    id: photo_preview
                                    source: "default_avatar.png"
                                    size_hint: None, None
                                    size: dp(56), dp(56)
                                    radius: [28,]
                                    pos_hint: {'center_x': 0.5}

                                MDIconButton:
                                    icon: "camera"
                                    pos_hint: {'center_x': 0.5}
                                    on_release: app.capture_photo()

                                MDLabel:
                                    text: "Capture Photo"
                                    font_style: "Caption"
                                    halign: "center"
                                    adaptive_height: True

                        MDTextField:
                            id: blood_group
                            hint_text: "Blood Group"
                            mode: "rectangle"
                            icon_left: "water"
                            readonly: True
                            on_touch_down: if self.collide_point(*args[1].pos): app.open_blood_group_menu()

                        MDTextField:
                            id: next_of_kin
                            hint_text: "Next of Kin *"
                            mode: "rectangle"
                            icon_left: "account"

                        MDTextField:
                            id: next_of_kin_phone
                            hint_text: "Next of Kin Phone *"
                            mode: "rectangle"
                            icon_left: "phone-outline"
                            input_filter: "int"

                        MDTextField:
                            id: dob
                            hint_text: "Date of Birth *"
                            mode: "rectangle"
                            icon_left: "calendar"
                            readonly: True
                            on_touch_down: if self.collide_point(*args[1].pos): app.open_date_picker()

                        MDTextField:
                            id: marital_status
                            hint_text: "Marital Status *"
                            mode: "rectangle"
                            icon_left: "heart-outline"
                            readonly: True
                            on_touch_down: if self.collide_point(*args[1].pos): app.open_marital_status_menu()

                        MDTextField:
                            id: nationality
                            hint_text: "Nationality *"
                            mode: "rectangle"
                            icon_left: "flag-outline"
                            text: "Nigerian"

                        MDTextField:
                            id: state_origin
                            hint_text: "State of Origin *"
                            mode: "rectangle"
                            icon_left: "map-outline"
                            readonly: True
                            on_touch_down: if self.collide_point(*args[1].pos): app.open_state_origin_menu()

                        MDTextField:
                            id: lga
                            hint_text: "LGA *"
                            mode: "rectangle"
                            icon_left: "city-variant-outline"

                        MDTextField:
                            id: address
                            hint_text: "Residential Address *"
                            mode: "rectangle"
                            icon_left: "home-outline"
                            multiline: True

                        MDLabel:
                            id: photo_status_label
                            text: ""
                            font_style: "Caption"
                            halign: "center"
                            theme_text_color: "Custom"
                            text_color: 0.8, 0.1, 0.1, 1
                            adaptive_height: True

                    # ---------------- Official Information ----------------
                    MDCard:
                        orientation: 'vertical'
                        padding: dp(16)
                        spacing: dp(12)
                        size_hint_y: None
                        height: self.minimum_height
                        radius: [12,]
                        elevation: 2

                        MDLabel:
                            text: "OFFICIAL INFORMATION"
                            font_style: "Subtitle1"
                            bold: True
                            adaptive_height: True

                        MDSeparator:

                        MDTextField:
                            id: state_office
                            hint_text: "State *"
                            mode: "rectangle"
                            icon_left: "map-marker-outline"
                            readonly: True
                            on_touch_down: if self.collide_point(*args[1].pos): app.open_state_office_menu()

                        # Auto-filled, read-only display of the selected State
                        # Office's fixed GPS coordinate (used for geofencing).
                        MDTextField:
                            id: gps_coordinate
                            hint_text: "Office GPS Coordinate"
                            mode: "rectangle"
                            icon_left: "crosshairs-gps"
                            readonly: True

                        MDTextField:
                            id: cluster
                            hint_text: "Which Cluster in State"
                            mode: "rectangle"
                            icon_left: "map-marker-radius-outline"

                        # Department | Section
                        MDBoxLayout:
                            orientation: 'horizontal'
                            spacing: dp(12)
                            size_hint_y: None
                            height: dp(56)

                            MDTextField:
                                id: department
                                hint_text: "Department *"
                                mode: "rectangle"
                                icon_left: "office-building-outline"
                                readonly: True
                                on_touch_down: if self.collide_point(*args[1].pos): app.open_department_menu()

                            MDTextField:
                                id: section
                                hint_text: "Section *"
                                mode: "rectangle"
                                icon_left: "file-tree-outline"
                                readonly: True
                                on_touch_down: if self.collide_point(*args[1].pos): app.open_section_menu()

                        MDTextField:
                            id: position
                            hint_text: "Position *"
                            mode: "rectangle"
                            icon_left: "account"

                        MDTextField:
                            id: employment_type
                            hint_text: "Employment Type *"
                            mode: "rectangle"
                            icon_left: "briefcase-outline"
                            readonly: True
                            on_touch_down: if self.collide_point(*args[1].pos): app.open_employment_type_menu()

                        MDTextField:
                            id: email
                            hint_text: "Office Email *"
                            mode: "rectangle"
                            icon_left: "email-outline"

                        # Phone No | Staff ID No
                        MDBoxLayout:
                            orientation: 'horizontal'
                            spacing: dp(12)
                            size_hint_y: None
                            height: dp(56)

                            MDTextField:
                                id: phone
                                hint_text: "Phone No *"
                                mode: "rectangle"
                                icon_left: "phone-outline"
                                input_filter: "int"

                            MDTextField:
                                id: staff_number
                                hint_text: "Staff ID No *"
                                mode: "rectangle"
                                icon_left: "card-account-details-outline"

                    # ---------------- Social Handles ----------------
                    MDCard:
                        orientation: 'vertical'
                        padding: dp(16)
                        spacing: dp(12)
                        size_hint_y: None
                        height: self.minimum_height
                        radius: [12,]
                        elevation: 2

                        MDLabel:
                            text: "SOCIAL HANDLES"
                            font_style: "Subtitle1"
                            bold: True
                            adaptive_height: True

                        MDSeparator:

                        # Facebook | Twitter
                        MDBoxLayout:
                            orientation: 'horizontal'
                            spacing: dp(12)
                            size_hint_y: None
                            height: dp(56)

                            MDBoxLayout:
                                orientation: 'horizontal'
                                spacing: dp(4)

                                MDIcon:
                                    icon: "facebook"
                                    theme_text_color: "Custom"
                                    text_color: 0.094, 0.467, 0.949, 1
                                    size_hint_x: None
                                    width: dp(32)
                                    halign: "center"

                                MDTextField:
                                    id: facebook
                                    hint_text: "Facebook"
                                    mode: "rectangle"

                            MDBoxLayout:
                                orientation: 'horizontal'
                                spacing: dp(4)

                                MDIcon:
                                    icon: "twitter"
                                    theme_text_color: "Custom"
                                    text_color: 0.114, 0.631, 0.949, 1
                                    size_hint_x: None
                                    width: dp(32)
                                    halign: "center"

                                MDTextField:
                                    id: twitter
                                    hint_text: "Twitter"
                                    mode: "rectangle"

                        # Instagram | Telegram
                        MDBoxLayout:
                            orientation: 'horizontal'
                            spacing: dp(12)
                            size_hint_y: None
                            height: dp(56)

                            MDBoxLayout:
                                orientation: 'horizontal'
                                spacing: dp(4)

                                MDIcon:
                                    icon: "instagram"
                                    theme_text_color: "Custom"
                                    text_color: 0.831, 0.180, 0.420, 1
                                    size_hint_x: None
                                    width: dp(32)
                                    halign: "center"

                                MDTextField:
                                    id: instagram
                                    hint_text: "Instagram"
                                    mode: "rectangle"

                            MDBoxLayout:
                                orientation: 'horizontal'
                                spacing: dp(4)

                                MDIcon:
                                    icon: "telegram"
                                    theme_text_color: "Custom"
                                    text_color: 0.149, 0.651, 0.863, 1
                                    size_hint_x: None
                                    width: dp(32)
                                    halign: "center"

                                MDTextField:
                                    id: telegram
                                    hint_text: "Telegram"
                                    mode: "rectangle"

                        MDBoxLayout:
                            orientation: 'horizontal'
                            spacing: dp(4)
                            size_hint_y: None
                            height: dp(56)

                            MDIcon:
                                icon: "linkedin"
                                theme_text_color: "Custom"
                                text_color: 0.039, 0.4, 0.761, 1
                                size_hint_x: None
                                width: dp(32)
                                halign: "center"

                            MDTextField:
                                id: linkedin
                                hint_text: "LinkedIn"
                                mode: "rectangle"

                        MDLabel:
                            text: "Leave blank to keep your current password" if app.current_user else ""
                            font_style: "Caption"
                            theme_text_color: "Secondary"
                            adaptive_height: True

                        # Create Password | Confirm Password
                        MDBoxLayout:
                            orientation: 'horizontal'
                            spacing: dp(12)
                            size_hint_y: None
                            height: dp(56)

                            MDBoxLayout:
                                orientation: 'horizontal'
                                MDTextField:
                                    id: password
                                    hint_text: "Create Password *" if not app.current_user else "Create Password"
                                    password: True
                                    mode: "rectangle"
                                MDIconButton:
                                    id: password_eye
                                    icon: "eye-off"
                                    on_release: app.toggle_password_field('password', self)

                            MDBoxLayout:
                                orientation: 'horizontal'
                                MDTextField:
                                    id: confirm_password
                                    hint_text: "Confirm Password *" if not app.current_user else "Confirm Password"
                                    password: True
                                    mode: "rectangle"
                                MDIconButton:
                                    id: confirm_password_eye
                                    icon: "eye-off"
                                    on_release: app.toggle_password_field('confirm_password', self)

                    # ---------------- Submit ----------------
                    MDRaisedButton:
                        text: "UPDATE PROFILE" if app.current_user else "SUBMIT"
                        font_size: "16sp"
                        size_hint_x: 1
                        height: dp(50)
                        md_bg_color: 0.1, 0.45, 0.85, 1
                        on_release: app.submit_staff()
