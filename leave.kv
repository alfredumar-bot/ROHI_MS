#:import dp kivy.metrics.dp

<LeaveScreen>:
    MDScreen:
        md_bg_color: 0.95, 0.95, 0.95, 1

        MDBoxLayout:
            orientation: "vertical"

            MDTopAppBar:
                title: "Leave Management"
                elevation: 2
                md_bg_color: 0.13, 0.40, 0.16, 1
                left_action_items: [["arrow-left", lambda x: app.open_dashboard()]]

            ScrollView:
                do_scroll_x: False
                do_scroll_y: True

                MDBoxLayout:
                    orientation: "vertical"
                    padding: dp(14)
                    spacing: dp(12)
                    size_hint_y: None
                    height: self.minimum_height

                    MDCard:
                        orientation: "vertical"
                        padding: dp(14)
                        spacing: dp(8)
                        size_hint_y: None
                        height: self.minimum_height
                        radius: [14,]
                        elevation: 2

                        MDLabel:
                            id: leave_staff
                            text: "Staff: -"
                            bold: True
                            adaptive_height: True
                        MDLabel:
                            id: leave_position
                            text: "Position: -"
                            theme_text_color: "Secondary"
                            adaptive_height: True

                    MDLabel:
                        text: "Leave Balance"
                        font_style: "Subtitle1"
                        bold: True
                        adaptive_height: True

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: dp(8)
                        size_hint_y: None
                        height: dp(190)

                        MDBoxLayout:
                            spacing: dp(8)
                            size_hint_y: None
                            height: dp(90)

                            MDCard:
                                orientation: "vertical"
                                padding: dp(10)
                                radius: [12,]
                                elevation: 1
                                MDLabel:
                                    text: "Annual"
                                    bold: True
                                    halign: "center"
                                MDLabel:
                                    id: annual_balance
                                    text: "20 days"
                                    halign: "center"
                                    theme_text_color: "Custom"
                                    text_color: 0.13, 0.40, 0.16, 1

                            MDCard:
                                orientation: "vertical"
                                padding: dp(10)
                                radius: [12,]
                                elevation: 1
                                MDLabel:
                                    text: "Sick"
                                    bold: True
                                    halign: "center"
                                MDLabel:
                                    id: sick_balance
                                    text: "10 days"
                                    halign: "center"
                                    theme_text_color: "Custom"
                                    text_color: 0.13, 0.40, 0.16, 1

                            MDCard:
                                orientation: "vertical"
                                padding: dp(10)
                                radius: [12,]
                                elevation: 1
                                MDLabel:
                                    text: "Maternity"
                                    bold: True
                                    halign: "center"
                                MDLabel:
                                    id: maternity_balance
                                    text: "84 days"
                                    halign: "center"
                                    theme_text_color: "Custom"
                                    text_color: 0.13, 0.40, 0.16, 1

                        MDBoxLayout:
                            spacing: dp(8)
                            size_hint_y: None
                            height: dp(90)

                            MDCard:
                                orientation: "vertical"
                                padding: dp(10)
                                radius: [12,]
                                elevation: 1
                                MDLabel:
                                    text: "Paternity"
                                    bold: True
                                    halign: "center"
                                MDLabel:
                                    id: paternity_balance
                                    text: "14 days"
                                    halign: "center"
                                    theme_text_color: "Custom"
                                    text_color: 0.13, 0.40, 0.16, 1

                            MDCard:
                                orientation: "vertical"
                                padding: dp(10)
                                radius: [12,]
                                elevation: 1
                                MDLabel:
                                    text: "Compassionate"
                                    bold: True
                                    halign: "center"
                                MDLabel:
                                    id: compassionate_balance
                                    text: "5 days"
                                    halign: "center"
                                    theme_text_color: "Custom"
                                    text_color: 0.13, 0.40, 0.16, 1

                            MDCard:
                                orientation: "vertical"
                                padding: dp(10)
                                radius: [12,]
                                elevation: 1
                                MDLabel:
                                    text: "Other"
                                    bold: True
                                    halign: "center"
                                MDLabel:
                                    id: other_balance
                                    text: "5 days"
                                    halign: "center"
                                    theme_text_color: "Custom"
                                    text_color: 0.13, 0.40, 0.16, 1

                    MDCard:
                        orientation: "vertical"
                        padding: dp(12)
                        spacing: dp(8)
                        size_hint_y: None
                        height: dp(112)
                        radius: [14,]
                        elevation: 2

                        MDLabel:
                            text: "Leave Request Status"
                            font_style: "Subtitle1"
                            bold: True
                            adaptive_height: True

                        MDBoxLayout:
                            spacing: dp(8)
                            size_hint_y: None
                            height: dp(62)

                            MDCard:
                                orientation: "vertical"
                                padding: dp(6)
                                radius: [10,]
                                elevation: 1
                                MDLabel:
                                    text: "Pending Request"
                                    halign: "center"
                                    font_style: "Caption"
                                MDLabel:
                                    id: pending_count
                                    text: "0"
                                    halign: "center"
                                    bold: True
                                    font_size: "20sp"
                                    theme_text_color: "Custom"
                                    text_color: 0.85, 0.55, 0.05, 1

                            MDCard:
                                orientation: "vertical"
                                padding: dp(6)
                                radius: [10,]
                                elevation: 1
                                MDLabel:
                                    text: "Approved Leave"
                                    halign: "center"
                                    font_style: "Caption"
                                MDLabel:
                                    id: approved_count
                                    text: "0"
                                    halign: "center"
                                    bold: True
                                    font_size: "20sp"
                                    theme_text_color: "Custom"
                                    text_color: 0.13, 0.40, 0.16, 1

                            MDCard:
                                orientation: "vertical"
                                padding: dp(6)
                                radius: [10,]
                                elevation: 1
                                MDLabel:
                                    text: "Rejected Leave"
                                    halign: "center"
                                    font_style: "Caption"
                                MDLabel:
                                    id: rejected_count
                                    text: "0"
                                    halign: "center"
                                    bold: True
                                    font_size: "20sp"
                                    theme_text_color: "Custom"
                                    text_color: 0.80, 0.10, 0.10, 1

                    MDCard:
                        orientation: "vertical"
                        padding: dp(14)
                        spacing: dp(10)
                        size_hint_y: None
                        height: self.minimum_height
                        radius: [14,]
                        elevation: 2

                        MDLabel:
                            text: "Apply for Leave"
                            font_style: "Subtitle1"
                            bold: True
                            adaptive_height: True

                        Spinner:
                            id: leave_type_spinner
                            text: "Annual Leave"
                            values: ["Annual Leave", "Sick Leave", "Maternity Leave", "Paternity Leave", "Compassionate Leave", "Other Leave"]
                            size_hint_y: None
                            height: dp(46)

                        MDBoxLayout:
                            spacing: dp(8)
                            size_hint_y: None
                            height: dp(54)
                            MDTextField:
                                id: leave_start
                                hint_text: "Start date (YYYY-MM-DD)"
                                mode: "rectangle"
                                text: ""
                            MDTextField:
                                id: leave_end
                                hint_text: "End date (YYYY-MM-DD)"
                                mode: "rectangle"
                                text: ""

                        MDTextField:
                            id: leave_reason
                            hint_text: "Reason / remarks"
                            mode: "rectangle"
                            multiline: True
                            size_hint_y: None
                            height: dp(90)

                        MDRaisedButton:
                            text: "SUBMIT LEAVE REQUEST"
                            md_bg_color: 0.13, 0.40, 0.16, 1
                            pos_hint: {"center_x": 0.5}
                            on_release: app.submit_leave_request()

                        MDLabel:
                            id: leave_message
                            text: ""
                            theme_text_color: "Custom"
                            text_color: 0.13, 0.40, 0.16, 1
                            halign: "center"
                            adaptive_height: True

                    MDCard:
                        orientation: "vertical"
                        padding: dp(14)
                        spacing: dp(8)
                        size_hint_y: None
                        height: self.minimum_height
                        radius: [14,]
                        elevation: 2

                        MDLabel:
                            text: "Leave History"
                            font_style: "Subtitle1"
                            bold: True
                            adaptive_height: True

                        MDLabel:
                            id: leave_history
                            text: "No leave requests yet."
                            theme_text_color: "Secondary"
                            adaptive_height: True
                            text_size: self.width, None

                    MDCard:
                        orientation: "vertical"
                        padding: dp(14)
                        spacing: dp(10)
                        size_hint_y: None
                        height: self.minimum_height
                        radius: [14,]
                        elevation: 2

                        MDLabel:
                            text: "Leave Report"
                            font_style: "Subtitle1"
                            bold: True
                            adaptive_height: True

                        MDBoxLayout:
                            orientation: "horizontal"
                            spacing: dp(10)
                            size_hint_y: None
                            height: dp(50)

                            MDRaisedButton:
                                text: "EXPORT LEAVE REPORT (EXCEL)"
                                size_hint_x: 1
                                md_bg_color: 0.13, 0.40, 0.16, 1
                                on_release: app.export_leave_excel()

                            MDIconButton:
                                icon: "email"
                                md_bg_color: 0.13, 0.40, 0.16, 1
                                theme_text_color: "Custom"
                                text_color: 1, 1, 1, 1
                                on_release: app.email_leave_report()

